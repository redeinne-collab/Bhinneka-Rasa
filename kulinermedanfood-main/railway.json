{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_20", "python3", "gcc", "gnumake"]
        },
        "install": {
          "cmds": ["npm install --prefix kulinermedanfood-main/backend"]
        },
        "build": {
          "cmds": ["npm run build --prefix kulinermedanfood-main/backend"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd kulinermedanfood-main/backend && node dist/scripts/initDb.js && npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
