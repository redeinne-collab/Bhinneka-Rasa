{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_20", "python3", "gcc", "gnumake"]
        },
        "install": {
          "cmds": ["cd backend && npm install"]
        },
        "build": {
          "cmds": ["cd backend && npm run build"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd backend && node dist/scripts/initDb.js && npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
