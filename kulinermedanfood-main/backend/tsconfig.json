{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": [
    "node_modules",
    "scripts/dedupeMenuItems.ts",
    "scripts/fixCoordinates.ts",
    "scripts/resetAdmin.ts",
    "scripts/seed-quiz.ts",
    "scripts/seedCookingSteps.ts",
    "scripts/seedKulinerData.ts",
    "scripts/seedMenuAndReviews.ts",
    "scripts/update-coordinates.ts",
    "scripts/updateFullContent.ts",
    "scripts/updateManualCoords.ts",
    "scripts/upgradeDishesSchema.ts"
  ]
}
